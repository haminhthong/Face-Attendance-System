# Python bytecode và cache
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
htmlcov/

# Môi trường và package build
.env
.venv/
venv/
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# IDE và hệ điều hành
.vscode/
.idea/
.DS_Store
Thumbs.db

# Log và dữ liệu runtime
*.log
*.db
*.db-shm
*.db-wal
face_attendance_data/
scratch/

# Dữ liệu sinh trắc học/private và kết quả cục bộ
data/private/**
!data/private/**/
!data/private/**/.gitkeep
data/results/**
!data/results/.gitkeep
