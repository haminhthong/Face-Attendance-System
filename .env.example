# Môi trường ứng dụng (development / production)
APP_ENV=development

# Khóa bảo mật REST API (bắt buộc thay đổi trong môi trường production)
FACE_ATTENDANCE_API_KEY=change-me

# Đường dẫn cơ sở dữ liệu & dữ liệu lưu trữ
DATABASE_PATH=face_attendance_data/face_attendance.db

# Phiên bản văn bản consent; độc lập với RECOGNITION_POLICY_PATH.
BIOMETRIC_CONSENT_POLICY_VERSION=biometric-consent-v1

# Recognition policy phải là một artifact thống nhất; không cấu hình threshold
# rời rạc ở nhiều biến môi trường.
RECOGNITION_POLICY_PATH=

# Cấu hình xử lý camera WebRTC
PROCESS_EVERY_N_FRAMES=3

# Chính sách lưu trữ dữ liệu sinh trắc học và giới hạn upload
BIOMETRIC_RETENTION_DAYS=365
MAX_UPLOAD_SIZE_MB=8
LOG_LEVEL=INFO
